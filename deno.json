{
  "lock": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["**/*.md"]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 tests/",
    "check": "deno check src/cli/main.ts src/catalog/mod.ts src/access/mod.ts src/audit/mod.ts src/portal/mod.ts src/portal/main.ts src/gateway/mod.ts src/gateway/main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "cli": "deno run --allow-read --allow-write --allow-env src/cli/main.ts",
    "portal": "deno run --allow-read --allow-env --allow-net=127.0.0.1 src/portal/main.ts",
    "gateway": "deno run --allow-read --allow-write --allow-env --allow-net=127.0.0.1 src/gateway/main.ts"
  },
  "exclude": ["data", "tmp"]
}

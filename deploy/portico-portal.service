# Portico Portal entrance.
#
# Install on the intranet test host (needs root):
#   sudo cp deploy/portico-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portico-portal
#
# ExecStart must be this checkout's versioned run script. Do not point at
# an unreviewed extra copy of the tree.
#
# The unit defaults to loopback. Set PORTICO_DEPLOY_BIND to an RFC1918
# unicast address at install time (drop-in or EnvironmentFile). Never bind
# every interface.
[Unit]
Description=Portico Portal (intranet test, not production)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=master
Group=master
Restart=on-failure
RestartSec=3
WorkingDirectory=/opt/portico
Environment=PORTICO_DEPLOY_BIND=127.0.0.1
Environment=PORTICO_DEPLOY_PORT=8788
ExecStartPre=-/usr/bin/docker rm -f portico-portal
ExecStart=/opt/portico/deploy/run-portal.sh
ExecStop=/usr/bin/docker stop portico-portal
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portico-portal

[Install]
WantedBy=multi-user.target

# Portico Portal entrance.
#
# Install on the intranet test host (needs root):
#   sudo cp deploy/portico-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portico-portal
#
# ExecStart must be this checkout's versioned run script. Do not point at
# /home/master/portico-runtime — that copy is not reviewed with the code.
[Unit]
Description=Portico Portal (intranet test, not production)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=master
Group=master
Restart=on-failure
RestartSec=3
WorkingDirectory=/home/master/src/portico
Environment=PORTICO_DEPLOY_BIND=10.201.15.192
Environment=PORTICO_DEPLOY_PORT=8788
ExecStartPre=-/usr/bin/docker rm -f portico-portal
ExecStart=/home/master/src/portico/deploy/run-portal.sh
ExecStop=/usr/bin/docker stop portico-portal
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portico-portal

[Install]
WantedBy=multi-user.target

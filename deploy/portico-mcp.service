# Portico MCP entrance (read-only, session-authenticated).
#
# Install on the intranet test host (needs root):
#   sudo cp deploy/portico-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portico-mcp
#
# ExecStart must be this checkout's versioned run script. Do not point at
# an unreviewed extra copy of the tree. MCP used to run as a detached
# unless-stopped container, so restarting portal/gateway left it on an
# old process.
#
# The unit defaults to loopback. Set PORTICO_DEPLOY_BIND to an RFC1918
# unicast address at install time (drop-in or EnvironmentFile). Never bind
# every interface.
[Unit]
Description=Portico MCP entrance (intranet test, not production)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=master
Group=master
Restart=on-failure
RestartSec=3
WorkingDirectory=/opt/portico
Environment=PORTICO_DEPLOY_BIND=127.0.0.1
Environment=PORTICO_DEPLOY_PORT=8790
ExecStartPre=-/usr/bin/docker rm -f portico-mcp
ExecStart=/opt/portico/deploy/run-mcp.sh
ExecStop=/usr/bin/docker stop portico-mcp
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portico-mcp

[Install]
WantedBy=multi-user.target

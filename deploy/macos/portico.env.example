# Portico host env (macOS template). Copied to $PORTICO_HOME/portico.env
# by render.sh on first run only; later runs never overwrite it.
# Cloudflare Access JWT mapping for Portal + Review is off unless
# ENABLED is true and TEAM + AUD are set; see docs/access/cf-access.md.
PORTICO_BIND=127.0.0.1
PORTICO_DATA_DIR=/Users/example/portico/data
PORTICO_PORT=8788
PORTICO_GATEWAY_PORT=8789
PORTICO_MCP_PORT=8790
PORTICO_REVIEW_PORT=8791
# PORTICO_CF_ACCESS_ENABLED=true
# PORTICO_CF_ACCESS_TEAM=example
# PORTICO_CF_ACCESS_AUD=example-audience

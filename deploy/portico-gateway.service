# Portico Gateway entrance (doorman only; never executes tools).
#
# Install on the intranet test host (needs root):
#   sudo cp deploy/portico-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portico-gateway
#
# ExecStart must be this checkout's versioned run script. Do not point at
# /home/master/portico-runtime — that copy is not reviewed with the code.
[Unit]
Description=Portico Gateway (intranet test, not production)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=master
Group=master
Restart=on-failure
RestartSec=3
WorkingDirectory=/home/master/src/portico
Environment=PORTICO_DEPLOY_BIND=10.201.15.192
Environment=PORTICO_DEPLOY_PORT=8789
ExecStartPre=-/usr/bin/docker rm -f portico-gateway
ExecStart=/home/master/src/portico/deploy/run-gateway.sh
ExecStop=/usr/bin/docker stop portico-gateway
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portico-gateway

[Install]
WantedBy=multi-user.target
